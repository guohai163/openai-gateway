# CI image: use latest, a version tag, or sha-<commit>.
GATEWAY_IMAGE=ghcr.io/guohai163/openai-gateway:latest
# Generate all secret values; do not use these example placeholders.
# Use hexadecimal passwords to avoid URL escaping in DATABASE_URL.
POSTGRES_USER=openai
POSTGRES_DB=openai
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
MASTER_KEY=replace-with-openssl-rand-base64-32
# Bootstrap administrator only; new accounts use email and all accounts bind TOTP.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
COOKIE_SECURE=true
BIND_ADDRESS=127.0.0.1
# Exact Nginx peer CIDRs only (for example its fixed Docker IP /32).
# Empty means ignore X-Forwarded-For and X-Real-IP. See deploy/nginx-proxy-protocol.conf.
TRUSTED_PROXIES=
REQUEST_TIMEOUT_SECONDS=600
# Direct binary deployment only:
# DATABASE_URL=postgresql://openai:password@127.0.0.1:5432/openai?sslmode=require

# Natural month statistics and S3 year-month paths use this IANA timezone.
REPORT_TIMEZONE=Asia/Shanghai
# Optional S3-compatible object storage. Leave all four required fields empty to disable.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true
